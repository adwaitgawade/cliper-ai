  "cards": [
    { "dot": "cyan", "title": "Primary path: video in, clip out", "items": [
      "1. Creator signs in with supabase-js; the web app sends the access token as a Bearer JWT",
      "2. Upload: ≤100 MB multipart via the API, larger files PUT straight to R2 with a presigned URL",
      "3. POST /v1/jobs writes the job row and enqueues a Celery chain through Redis",
      "4. Workers ingest, transcribe, shortlist and LLM-score candidates, then pick clips",
      "5. Render task runs Remotion in Node, normalizes loudness, uploads clip.mp4 + captions to R2",
      "6. Web app follows progress over SSE and downloads via a presigned GET"
    ] },
    { "dot": "rose", "title": "Trust boundaries", "items": [
      "Browser holds only the publishable Supabase key and the user's JWT",
      "API verifies every token (JWKS; HS256 asks the Auth server) or a cp_ workspace API key, then scopes by X-Workspace-Id",
      "Service secrets (DB, R2, Redis, OpenCode) live only in the containers' .env",
      "R2 objects reach the browser only through time-limited presigned URLs",
      "URL ingest and webhook targets must resolve to public hosts; webhooks are HMAC-signed"
    ] },
    { "dot": "emerald", "title": "Pipeline mechanics", "items": [
      "Queues: gpu (transcribe), cpu (ingest, render), default (analyze, fan-out, finalize)",
      "acks_late + heartbeat; beat requeues stale jobs every 5 min and purges expired videos hourly",
      "Job completes once clips are picked; top-N clips pre-render, the rest render on download",
      "Workers also write source, audio, transcript and thumbnails to R2 (edge omitted)"
    ] },
    { "dot": "amber", "title": "Swappable dependencies", "items": [
      "STT engine from stt.toml: local Parakeet Redux (default), AssemblyAI API, or faster-whisper",
      "LLM: OpenCode primary + fallback model, per-job USD budget, Redis score cache; heuristic scorer when LLM_MODEL is empty",
      "Preview and render share packages/video, so the Player shows what the worker exports"
    ] },
    { "dot": "slate", "title": "Outside this view", "items": [
      "apps/main-site: client-only marketing site, never calls the API",
      "Outbound job webhooks to integrator URLs",
      "apps/docs and build-time tooling"
    ] }
  ]
