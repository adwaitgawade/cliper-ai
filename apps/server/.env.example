# Copy to .env and fill in. Never commit .env.

# --- Supabase (Project Settings > API / Database) ---------------------------------
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Only needed if the project still signs tokens with the legacy HS256 secret.
# New projects use asymmetric keys, verified locally via JWKS.
SUPABASE_PUBLISHABLE_KEY=

# Database > Connect > Session pooler (port 5432). Paste it as-is; the
# [YOUR-PASSWORD] placeholder is replaced with DATABASE_PASSWORD.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=

# --- Redis (Celery broker, rate limits, LLM cache) ----------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible) ---------------------------------------------------
# Cloudflare R2 > Manage API tokens (Object Read & Write). The bucket needs a CORS rule
# allowing GET/PUT from the web origin.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=clippro
S3_FORCE_PATH_STYLE=true

# --- AI (Vercel AI Gateway: LLMs and speech-to-text) ------------------------------------
# One key for every model: https://vercel.com/docs/ai-gateway/authentication-and-byok
AI_GATEWAY_API_KEY=
# provider:model for the LLM factory (app/llm/factory.py):
#   gateway:<creator>/<model>   Vercel AI Gateway (ids: curl https://ai-gateway.vercel.sh/v1/models)
#   opencode:<model-id>         OpenCode (needs OPENCODE_API_KEY, OPENCODE_BASE_URL)
#   <provider>:<model>          anything langchain's init_chat_model supports
# Leave LLM_MODEL empty to use the built-in heuristic scorer.
LLM_MODEL=gateway:anthropic/claude-haiku-5.5
LLM_FALLBACK_MODEL=gateway:deepseek/deepseek-v4-flash
LLM_BUDGET_USD_PER_JOB=2.0
# USD per 1M tokens, for cost tracking and the per-job budget cap. Gateway models missing
# here are priced from the gateway's public catalog; entries here override it.
LLM_PRICES={}
OPENCODE_API_KEY=
# Optional LangSmith tracing:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# --- Pipeline ------------------------------------------------------------------------------
# Speech-to-text engine (gateway, redux, assemblyai, whisper) and its settings: edit stt.toml.
# Only needed when stt.toml has provider = "assemblyai":
ASSEMBLYAI_API_KEY=
VIDEO_ENCODER=libx264
# Set false only on dev machines whose ffmpeg lacks libass.
CAPTIONS_BURN_IN=true

# AI edits in the clip editor; empty uses LLM_MODEL (and LLM_FALLBACK_MODEL).
AI_EDIT_MODEL=

# --- Fairness between workspaces (0 disables a cap) ---------------------------------------
WORKSPACE_MAX_ACTIVE_JOBS=2
WORKSPACE_MAX_CONCURRENT_RENDERS=2

# --- Storage housekeeping ---------------------------------------------------------------
# Reuse downloads and transcripts of the same public URL across workspaces.
SHARED_CACHE_ENABLED=true
SHARED_CACHE_TTL_DAYS=14
ORPHAN_MIN_AGE_HOURS=24

# --- Alerts ----------------------------------------------------------------------------------
# Slack-compatible incoming webhook for queue delays, crashes and 500s. Always logged as "alert".
ALERT_WEBHOOK_URL=
QUEUE_DELAY_ALERT_SECONDS=300

# --- Misc ----------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
WEBHOOK_SIGNING_SECRET=
LOG_JSON=false
