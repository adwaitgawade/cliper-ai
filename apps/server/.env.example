# Copy to .env and fill in. Never commit .env.

# --- Supabase (Project Settings > API / Database) ---------------------------------
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Only needed if the project still signs tokens with the legacy HS256 secret.
# New projects use asymmetric keys, verified locally via JWKS.
SUPABASE_PUBLISHABLE_KEY=

# Database > Connect > Session pooler (port 5432). Paste it as-is; the
# [YOUR-PASSWORD] placeholder is replaced with DATABASE_PASSWORD.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=

# --- Redis (Celery broker, rate limits, LLM cache) ----------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible) ---------------------------------------------------
# Local SeaweedFS from docker-compose (dev keys in docker/seaweedfs-s3.json). For Supabase Storage use
#   https://<project-ref>.storage.supabase.co/storage/v1/s3 with S3 access keys
# (Storage > S3 Configuration). For AWS S3 leave S3_ENDPOINT_URL empty.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=clippro-media
S3_FORCE_PATH_STYLE=true

# --- LLM (provider:model for langchain init_chat_model) --------------------------------
# OpenCode: opencode:<model-id> (Go models: curl https://opencode.ai/zen/go/v1/models).
# OPENCODE_BASE_URL defaults to the Go subscription (https://opencode.ai/zen/go); use
# https://opencode.ai/zen for pay-as-you-go balance.
# Leave LLM_MODEL empty to use the built-in heuristic scorer.
OPENCODE_API_KEY=
LLM_MODEL=opencode:claude-haiku-5-5
LLM_FALLBACK_MODEL=opencode:deepseek-v4-flash
LLM_BUDGET_USD_PER_JOB=2.0
# USD per 1M tokens (OpenCode Go table; DeepSeek at its peak rate), used for cost tracking
# and the per-job budget cap.
LLM_PRICES={"opencode:claude-haiku-5-5": [0.10, 0.50], "opencode:deepseek-v4-flash": [0.30, 1.20]}
# Optional LangSmith tracing:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# --- Pipeline ------------------------------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=auto
VIDEO_ENCODER=libx264
# Set false only on dev machines whose ffmpeg lacks libass.
CAPTIONS_BURN_IN=true

# --- Misc ----------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
WEBHOOK_SIGNING_SECRET=
LOG_JSON=false
