# Copy to .env.local. Every NEXT_PUBLIC_ value is sent to the browser, so only public values go here.
# Supabase: Project Settings > API (the same project as apps/server).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The FastAPI server (apps/server). Its CORS_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
# The marketing site (apps/main-site), for "Back to website" and the Terms/Privacy links on auth screens.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
