{
  "version": 1,
  "default_style": "bold_highlight",
  "canvas": { "width": 1080, "height": 1920, "max_fps": 30, "side_margin": 90 },
  "limits": {
    "size": [40, 140],
    "outline_width": [0, 16],
    "position_y": [0.12, 0.78],
    "max_words": [1, 4]
  },
  "fonts": {
    "montserrat": { "family": "Montserrat", "weights": [600, 800, 900] },
    "inter": { "family": "Inter", "weights": [500, 600, 800] },
    "poppins": { "family": "Poppins", "weights": [600, 800] },
    "bebas_neue": { "family": "Bebas Neue", "weights": [400] },
    "anton": { "family": "Anton", "weights": [400] },
    "oswald": { "family": "Oswald", "weights": [600, 700] },
    "roboto": { "family": "Roboto", "weights": [500, 900] },
    "archivo_black": { "family": "Archivo Black", "weights": [400] }
  },
  "presets": {
    "bold_highlight": {
      "label": "Bold highlight",
      "description": "Heavy uppercase words; the spoken word turns yellow and pops.",
      "font": "montserrat",
      "weight": 900,
      "size": 86,
      "text_color": "#FFFFFF",
      "highlight_color": "#FFE500",
      "outline_color": "#000000",
      "outline_width": 6,
      "shadow": 2,
      "box_color": null,
      "uppercase": true,
      "max_words": 3,
      "max_chars": 18,
      "position_y": 0.68,
      "highlight_mode": "word",
      "highlight_scale": 1.08
    },
    "clean": {
      "label": "Clean",
      "description": "Sentence case with a thin outline and a soft blue active word.",
      "font": "inter",
      "weight": 600,
      "size": 70,
      "text_color": "#FFFFFF",
      "highlight_color": "#64C8FF",
      "outline_color": "#202020",
      "outline_width": 3,
      "shadow": 0,
      "box_color": null,
      "uppercase": false,
      "max_words": 4,
      "max_chars": 24,
      "position_y": 0.7,
      "highlight_mode": "word",
      "highlight_scale": 1.0
    },
    "karaoke": {
      "label": "Karaoke",
      "description": "Words fill with green as they are spoken.",
      "font": "poppins",
      "weight": 800,
      "size": 80,
      "text_color": "#FFFFFF",
      "highlight_color": "#7FFF00",
      "outline_color": "#000000",
      "outline_width": 5,
      "shadow": 1,
      "box_color": null,
      "uppercase": false,
      "max_words": 4,
      "max_chars": 22,
      "position_y": 0.68,
      "highlight_mode": "karaoke",
      "highlight_scale": 1.0
    },
    "boxed": {
      "label": "Boxed",
      "description": "White text on a translucent dark box.",
      "font": "poppins",
      "weight": 800,
      "size": 72,
      "text_color": "#FFFFFF",
      "highlight_color": "#FFE500",
      "outline_color": "#000000",
      "outline_width": 0,
      "shadow": 0,
      "box_color": "#00000099",
      "uppercase": false,
      "max_words": 3,
      "max_chars": 20,
      "position_y": 0.68,
      "highlight_mode": "word",
      "highlight_scale": 1.0
    },
    "impact": {
      "label": "Impact",
      "description": "Tall condensed uppercase with a green pop on each word.",
      "font": "anton",
      "weight": 400,
      "size": 110,
      "text_color": "#FFFFFF",
      "highlight_color": "#2BFF88",
      "outline_color": "#000000",
      "outline_width": 8,
      "shadow": 3,
      "box_color": null,
      "uppercase": true,
      "max_words": 2,
      "max_chars": 14,
      "position_y": 0.62,
      "highlight_mode": "word",
      "highlight_scale": 1.12
    },
    "subtle": {
      "label": "Subtle",
      "description": "Small, quiet captions without word highlighting.",
      "font": "inter",
      "weight": 500,
      "size": 58,
      "text_color": "#FFFFFF",
      "highlight_color": "#FFFFFF",
      "outline_color": "#000000",
      "outline_width": 0,
      "shadow": 4,
      "box_color": null,
      "uppercase": false,
      "max_words": 4,
      "max_chars": 28,
      "position_y": 0.74,
      "highlight_mode": "none",
      "highlight_scale": 1.0
    }
  },
  "profanity": ["fuck", "fucking", "shit", "bitch", "asshole", "bastard", "dick", "cunt", "motherfucker"]
}
